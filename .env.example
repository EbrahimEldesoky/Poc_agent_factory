# Copy to .env and fill in. Never commit .env.
# Set the key for the provider/model you select: Anthropic, Gemini, or Groq. Claude OAuth is also supported.
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# Random strings (e.g. `openssl rand -hex 32`)
BROKER_TOKEN=
SESSION_SECRET=
# Seeded owner account
OWNER_EMAIL=owner@acme.test
OWNER_PASSWORD=changeme
