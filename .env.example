# Copy to .env and fill in. Never commit .env.
# Model access: an API key (console.anthropic.com) OR a Claude subscription token (`claude setup-token`).
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
# Random strings (e.g. `openssl rand -hex 32`)
BROKER_TOKEN=
SESSION_SECRET=
# Seeded owner account
OWNER_EMAIL=owner@acme.test
OWNER_PASSWORD=changeme
