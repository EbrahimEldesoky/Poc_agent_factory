# Copy to .env and fill in all required values before running docker compose.
# Never commit .env.

# Required platform secrets (generate with: openssl rand -hex 32)
BROKER_TOKEN=
SESSION_SECRET=

# Required database password (generate with: openssl rand -hex 16)
POSTGRES_PASSWORD=

# Seeded owner account (set a strong password, at least 8 characters; do not use "changeme")
OWNER_EMAIL=owner@acme.test
OWNER_PASSWORD=

# Model provider credentials: set the key for the provider/model you select
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional web/security settings
WEB_PORT=3000
# Set to "true" when served behind HTTPS, or "auto" (default) to detect from proxy/TLS headers
COOKIE_SECURE=auto
# Set to "true" if a trusted reverse proxy sets X-Forwarded-Proto
TRUST_PROXY=false
# Comma-separated list of allowed cross-origin origins (empty = same-origin only)
CORS_ALLOWED_ORIGINS=
